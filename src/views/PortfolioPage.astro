---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeOf, routes, t } from '../i18n';

const locale = localeOf(Astro.currentLocale);
const { projects, ui } = t(locale);
const p = ui.portfolio;

type GroupKey = 'tools' | 'websites' | 'other';

// Group keys are stable across languages; the filter chips and sections use them.
const groupIds: { key: Exclude<GroupKey, 'other'>; ids: string[] }[] = [
  {
    key: 'tools',
    ids: ['spento', 'miso', 'prompting-guidelines', 'backoffice-system', 'ui-library', 'migration-tool'],
  },
  {
    key: 'websites',
    ids: ['sanders-mantilla', 'raffoom-platform', 'plapers', 'red-consultores', 'photography-site'],
  },
];

const groups: { key: GroupKey; title: string; projects: typeof projects }[] = groupIds.map((group) => ({
  key: group.key,
  title: p.groups[group.key],
  projects: group.ids.flatMap((id) => projects.filter((project) => project.id === id)),
}));

const groupedIds = groups.flatMap((group) => group.projects.map((project) => project.id));
const ungrouped = projects.filter((project) => !groupedIds.includes(project.id));
if (ungrouped.length > 0) groups.push({ key: 'other', title: p.groups.other, projects: ungrouped });
---

<BaseLayout title={p.title} description={p.description} alternates={routes.portfolio}>
  <div class="page-head">
    <h1 class="term-title">
      <span class="tk-pink">{p.h1}</span>
    </h1>
    <p class="muted">{p.intro}</p>
  </div>

  <div class="project-filters" role="group" aria-label={p.filter} hidden>
    <button type="button" class="filter-chip is-active" data-filter="all" aria-pressed="true">
      {p.all} <span class="chip-count">{projects.length}</span>
    </button>
    {groups.map((group) => (
      <button type="button" class="filter-chip" data-filter={group.key} aria-pressed="false">
        {group.title} <span class="chip-count">{group.projects.length}</span>
      </button>
    ))}
  </div>

  {groups.map((group) => (
  <div class="project-group" data-group={group.key}>
  <h2 class="project-group-title">{group.title}</h2>
  <section class="projects" aria-label={group.title}>
    {
      group.projects.map((project) => (
        <article class="project">
          <div class="project-bar">
            <div class="dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <span class="file">{project.id}.tsx</span>
          </div>
          {project.mobileShots && project.mobileShots.length > 0 ? (
            <div class="project-shots" data-shape={project.shotShape ?? 'portrait'} data-gallery={project.gallery ? JSON.stringify(project.gallery) : undefined} data-title={project.title}>
              {project.mobileShots.map((src) => {
                const index = project.gallery ? project.gallery.findIndex((item) => item.src === src) : -1;
                const img = <img src={src} alt={`${project.title} ${p.screen}`} width="390" height="844" loading="lazy" decoding="async" />;
                return index >= 0 ? (
                  <button type="button" class="phone" data-index={index} aria-label={`${project.title}: ${p.viewFull}`}>{img}</button>
                ) : (
                  <div class="phone">{img}</div>
                );
              })}
            </div>
          ) : project.image ? (
            <div class="project-shot">
              <img src={project.image} alt={`${project.title} ${p.homepage}`} width="1280" height="800" loading="lazy" decoding="async" />
            </div>
          ) : null}
          <div class="project-body">
            <div class="project-head">
              <h3>{project.title}</h3>
              {project.status === 'in-progress' && <span class="wip">{p.wip}</span>}
            </div>
            <p class="desc">{project.description}</p>
            {project.outcome && <p class="outcome">{project.outcome}</p>}
            <div class="hashtags" aria-label={p.focus}>
              {project.categories.map((category) => (
                <span>#{category}</span>
              ))}
            </div>
            {project.technologies && project.technologies.length > 0 && (
              <p class="technology-list"><strong>{p.technology}</strong> {project.technologies.join(' · ')}</p>
            )}
            <div class="project-actions">
              {project.github ? (
                <a href={project.github} target="_blank" rel="noopener noreferrer">{p.source}</a>
              ) : project.visibility === 'public' ? (
                <span class="public">{p.public}</span>
              ) : (
                <span class="private" title={p.privateTitle}>{p.private}</span>
              )}
              {project.link && (
                <a class="live" href={project.link} target="_blank" rel="noopener noreferrer">{p.visit}</a>
              )}
            </div>
          </div>
          <div class="sheen" aria-hidden="true"></div>
        </article>
      ))
    }
  </section>
  </div>
  ))}

  <dialog class="lightbox" id="lightbox" aria-label={p.lightbox}>
    <button type="button" class="lb-btn lb-close" aria-label={p.close}>×</button>
    <button type="button" class="lb-btn lb-nav lb-prev" aria-label={p.prev}>‹</button>
    <figure class="lb-figure">
      <img class="lb-img" alt="" />
      <figcaption class="lb-caption"></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-nav lb-next" aria-label={p.next}>›</button>
  </dialog>

  <script>
    // Lightbox for galleries (native <dialog>: Esc closes, focus is trapped and restored).
    const box = document.querySelector<HTMLDialogElement>('#lightbox');
    if (box) {
      const img = box.querySelector<HTMLImageElement>('.lb-img')!;
      const caption = box.querySelector<HTMLElement>('.lb-caption')!;
      let items: { src: string; caption: string }[] = [];
      let current = 0;

      const show = (i: number) => {
        current = (i + items.length) % items.length;
        const item = items[current];
        img.src = item.src;
        img.alt = item.caption;
        caption.textContent = `${current + 1} / ${items.length} · ${item.caption}`;
      };

      document.querySelectorAll<HTMLElement>('.project-shots[data-gallery]').forEach((shots) => {
        shots.querySelectorAll<HTMLButtonElement>('button.phone').forEach((btn) => {
          btn.addEventListener('click', () => {
            items = JSON.parse(shots.dataset.gallery ?? '[]');
            show(Number(btn.dataset.index));
            box.showModal();
          });
        });
      });

      box.querySelector('.lb-close')!.addEventListener('click', () => box.close());
      box.querySelector('.lb-prev')!.addEventListener('click', () => show(current - 1));
      box.querySelector('.lb-next')!.addEventListener('click', () => show(current + 1));

      // Click on the dark backdrop closes.
      box.addEventListener('click', (e) => {
        if (e.target === box) box.close();
      });
      box.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });

      // Swipe on touch screens.
      let startX = 0;
      box.addEventListener('touchstart', (e) => { startX = e.changedTouches[0].clientX; }, { passive: true });
      box.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
      });
    }
  </script>

  <script>
    const bar = document.querySelector<HTMLElement>('.project-filters');
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-chip'));
    const groupEls = Array.from(document.querySelectorAll<HTMLElement>('.project-group'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';

    // Filters need JS, so they stay hidden without it.
    if (bar) bar.hidden = false;

    const applyFilter = (filter: string) => {
      const animate = !reduceMotion.matches;
      const visible = groupEls.filter((el) => !el.hidden);
      const before = new Map(visible.map((el) => [el, el.getBoundingClientRect().top]));

      groupEls.forEach((el) => {
        el.getAnimations().forEach((a) => a.cancel());
        el.hidden = !(filter === 'all' || el.dataset.group === filter);
      });

      groupEls.forEach((el) => {
        if (el.hidden || !animate) return;

        if (before.has(el)) {
          // Already on screen: slide from its old position to the new one.
          const dy = before.get(el)! - el.getBoundingClientRect().top;
          if (Math.abs(dy) > 1) {
            el.animate(
              [{ transform: `translateY(${dy}px)` }, { transform: 'translateY(0)' }],
              { duration: 380, easing: EASE },
            );
          }
        } else {
          // Newly shown: cards fade up one after another.
          el.querySelectorAll<HTMLElement>('.project-group-title, .project').forEach((node, i) => {
            node.animate(
              [
                { opacity: 0, transform: 'translateY(14px) scale(0.98)' },
                { opacity: 1, transform: 'translateY(0) scale(1)' },
              ],
              { duration: 420, delay: i * 60, easing: EASE, fill: 'backwards' },
            );
          });
        }
      });
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        if (chip.classList.contains('is-active')) return;
        chips.forEach((c) => {
          const on = c === chip;
          c.classList.toggle('is-active', on);
          c.setAttribute('aria-pressed', String(on));
        });
        applyFilter(chip.dataset.filter ?? 'all');
      });
    });
  </script>
</BaseLayout>
