---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Hero from '../components/home/Hero.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import Services from '../components/home/Services.astro';
import Approach from '../components/home/Approach.astro';
import FeaturedWork from '../components/home/FeaturedWork.astro';
import ClosingCta from '../components/home/ClosingCta.astro';
import Insights from '../components/home/Insights.astro';
import { localeOf, postLocale, routes, servicePath, t } from '../i18n';

const locale = localeOf(Astro.currentLocale);
const { site, ui, packages } = t(locale);

const latestPosts = (await getCollection('blog', (entry) => !entry.data.draft && postLocale(entry.id) === locale))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const homeLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${site.name}, ${ui.home.schemaName}`,
  url: site.url,
  description: site.description,
  image: new URL('/profile.jpg', site.url).href,
  address: { '@type': 'PostalAddress', addressCountry: 'MX' },
  areaServed: 'Worldwide',
  founder: { '@type': 'Person', name: site.name },
  sameAs: site.social.map((item) => item.href),
  makesOffer: packages.tiers.map((tier) => ({
    '@type': 'Offer',
    ...(tier.offer ? { price: tier.offer.amount, priceCurrency: tier.offer.currency } : {}),
    itemOffered: {
      '@type': 'Service',
      name: tier.name,
      description: tier.desc,
      url: new URL(servicePath(locale, tier.slug), site.url).href,
    },
  })),
};
---

<BaseLayout title={ui.home.title} description={site.description} schema={homeLd} alternates={routes.home}>
  <Hero />
  <ProofStrip />
  <Services />
  <Approach />
  <FeaturedWork />
  <ClosingCta />
  <Insights posts={latestPosts} />
</BaseLayout>
