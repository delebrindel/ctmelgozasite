---
import type { CollectionEntry } from 'astro:content';
import { blogPath, localeOf, postSlug, routes, t } from '../../i18n';
import { formatDate } from '../../lib/format';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const locale = localeOf(Astro.currentLocale);
const { ui } = t(locale);
---

{posts.length > 0 && (
  <section class="insights-section">
    <div class="section-heading"><p class="eyebrow">{ui.insights.eyebrow}</p><h2>{ui.insights.h2}</h2></div>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={blogPath(locale, postSlug(post.id))}>{post.data.title}</a>
          <div class="muted"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, ui.dateLocale)}</time></div>
        </li>
      ))}
    </ul>
    <p><a href={routes.blog[locale]}>{ui.insights.all} →</a></p>
  </section>
)}
