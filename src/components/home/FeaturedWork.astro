---
import { localeOf, routes, t } from '../../i18n';

const locale = localeOf(Astro.currentLocale);
const { ui } = t(locale);
---

<section class="featured-work">
  <div class="section-heading">
    <p class="eyebrow">{ui.featured.eyebrow}</p>
    <h2>{ui.featured.h2}</h2>
    <p class="packages-intro">{ui.featured.intro}</p>
  </div>
  <div class="work-grid">
    {ui.featured.items.map((item) => (
      <article class="work-card">
        <span class="work-type">{item.type}</span>
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </article>
    ))}
  </div>
  <p class="work-link"><a href={routes.portfolio[locale]}>{ui.featured.portfolio} →</a></p>
</section>
