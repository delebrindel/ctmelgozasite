---
import { localeOf, routes, t } from '../../i18n';

const locale = localeOf(Astro.currentLocale);
const { site, ui } = t(locale);
---

<section class="hero">
  <div class="hero-text">
    <p class="eyebrow">{ui.hero.eyebrow}</p>
    <h1>{ui.hero.h1}</h1>
    <p class="role">{ui.hero.role}</p>
    <div class="intro">
      <p>{site.intro}</p>
      <p>{site.background}</p>
    </div>
    <div class="hero-actions">
      <a class="primary-cta" href={routes.contact[locale]}>{ui.hero.discuss} <span aria-hidden="true">→</span></a>
      <a class="secondary-cta" href={routes.portfolio[locale]}>{ui.hero.portfolio}</a>
    </div>
    <p class="response-note">{ui.hero.response}</p>
  </div>

  <div class="photo-wrap">
    <div class="photo-layer cyan" aria-hidden="true"></div>
    <div class="photo-layer pink" aria-hidden="true"></div>
    <div class="photo">
      <img src="/assets/img/mascot.png" alt={ui.hero.photoAlt} />
    </div>
    <span class="photo-badge">{site.name}</span>
  </div>
</section>

<style>
  .focus { font-size: clamp(1.25rem, 2.2vw, 1.5rem); font-weight: 600; color: var(--text); margin: 0 0 1rem; }
</style>
