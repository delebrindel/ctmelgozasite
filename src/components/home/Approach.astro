---
import { localeOf, t } from '../../i18n';

const { ui } = t(localeOf(Astro.currentLocale));
---

<section class="approach-section">
  <div>
    <p class="eyebrow">{ui.approach.eyebrow}</p>
    <h2>{ui.approach.h2}</h2>
  </div>
  <ol class="approach-steps">
    {ui.approach.steps.map((step) => (
      <li><strong>{step.title}</strong><span>{step.body}</span></li>
    ))}
  </ol>
</section>
