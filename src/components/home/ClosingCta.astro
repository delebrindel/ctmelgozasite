---
import { localeOf, routes, t } from '../../i18n';

const locale = localeOf(Astro.currentLocale);
const { ui } = t(locale);
---

<section class="closing-cta">
  <p class="eyebrow">{ui.closing.eyebrow}</p>
  <h2>{ui.closing.h2}</h2>
  <p>{ui.closing.body}</p>
  <a class="primary-cta" href={routes.contact[locale]}>{ui.closing.cta} <span aria-hidden="true">→</span></a>
</section>
