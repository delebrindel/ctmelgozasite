---
import { getCollection } from 'astro:content';
import { localeOf, otherLocale, postLocale, routes, t } from '../i18n';

interface Props {
  /** The current page's path in the other language. */
  alternate: string;
}

const { alternate } = Astro.props;
const locale = localeOf(Astro.currentLocale);
const other = otherLocale(locale);
const { site, ui } = t(locale);

// Hide the Blog link until at least one post is published in this language.
const hasPosts = (await getCollection('blog', (entry) => !entry.data.draft && postLocale(entry.id) === locale)).length > 0;

const links = [
  { href: `${routes.home[locale]}#services`, label: ui.nav.services },
  { href: routes.portfolio[locale], label: ui.nav.portfolio },
  { href: routes.cv[locale], label: ui.nav.cv },
  ...(hasPosts ? [{ href: routes.blog[locale], label: ui.nav.blog }] : []),
];

const path = Astro.url.pathname;
const isCurrent = (href: string): boolean => {
  const route = href.split('#')[0];
  return route === routes.home[locale] ? path === route : path.startsWith(route);
};
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={routes.home[locale]}><span class="bracket">&lt;</span>{site.name}<span class="bracket">/&gt;</span></a>
    <nav class="site-nav" aria-label={ui.nav.primary}>
      {
        links.map((link, i) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            <span class="num">0{i + 1}.</span>
            {link.label}
          </a>
        ))
      }
    </nav>
    <a class="header-cta" href={routes.contact[locale]}>{ui.nav.discuss} <span aria-hidden="true">→</span></a>
    <a class="lang-switch" href={alternate} lang={other}>{ui.switchTo}</a>
  </div>
</header>

<nav class="mobile-nav" aria-label={ui.nav.mobile}>
  {
    links.map((link) => (
      <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
        {link.label}
      </a>
    ))
  }
  <a href={routes.contact[locale]} aria-current={path.startsWith(routes.contact[locale]) ? 'page' : undefined}>{ui.nav.contact}</a>
  <a class="lang-switch" href={alternate} lang={other}>{ui.switchTo}</a>
</nav>
