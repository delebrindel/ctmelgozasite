---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, packages, projects } from '../../data/site';

export function getStaticPaths() {
  return packages.tiers.map((tier) => ({
    params: { slug: tier.slug },
    props: { tier },
  }));
}

const { tier } = Astro.props;
const serviceName = `${tier.name} consulting`;
const related = projects.filter((project) => tier.projectIds.includes(project.id));
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: serviceName,
  serviceType: tier.name,
  description: tier.desc,
  url: new URL(`/services/${tier.slug}/`, site.url).href,
  provider: { '@type': 'Person', name: site.name, url: site.url },
};
---

<BaseLayout title={serviceName} description={tier.desc} schema={serviceLd}>
  <section class="service-page">
    <p class="back"><a href="/#services">← All services</a></p>
    <div class="section-heading">
      <p class="eyebrow">{tier.time}</p>
      <h1>{serviceName}</h1>
      <p class="packages-intro">{tier.desc}</p>
    </div>

    <div class="service-detail">
      <h2>What's included</h2>
      <ul class="service-list">
        {tier.bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
    </div>

    {related.length > 0 && (
      <section class="service-related">
        <h2>Related work</h2>
        <div class="work-grid">
          {related.map((project) => (
            <article class="work-card">
              <span class="work-type">{project.stack.slice(0, 3).join(' · ')}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              {project.outcome && <p class="outcome">{project.outcome}</p>}
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="closing-cta">
      <p class="eyebrow">Next step</p>
      <h2>Tell me what needs to change.</h2>
      <p>Share the system, the constraints, and the outcome you need. I’ll reply with a practical way to start.</p>
      <a class="primary-cta" href="/contact/">{tier.cta} <span aria-hidden="true">→</span></a>
    </section>
  </section>
</BaseLayout>

<style>
  .back { margin: 0 0 1.5rem; font-size: 0.9rem; }
  .service-detail, .service-related { margin-top: 2.5rem; }
  .service-list { list-style: none; padding: 0; margin: 1rem 0 0; }
  .service-list li { padding: 0.5rem 0; border-bottom: 1px solid var(--border); }
  .service-list li::before { content: "• "; color: var(--purple); }
</style>
