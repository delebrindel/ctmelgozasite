---
import BaseLayout from '../layouts/BaseLayout.astro';
import { packages, site } from '../data/site';

const timeframes = ['Less than 1 month', '1–3 months', '3–6 months', '6+ months'];
const diagnosticSlug = 'technical-diagnostic';
const diagnosticName = packages.tiers.find((tier) => tier.slug === diagnosticSlug)?.name ?? '';
---

<BaseLayout title="Contact a Software Engineering Consultant" description="Request an independent technical diagnostic, plan a legacy modernization sprint, or discuss fractional engineering leadership with Cristóbal Torres.">
  <div class="page-head">
    <p class="eyebrow">Start a conversation</p>
    <h1>Tell me what your software needs next.</h1>
    <p class="muted">Share the challenge, the people involved, and what a useful outcome would look like. I’ll review the details and get back to you about a next step.</p>
  </div>

  <form class="contact-form" id="contact-form" action="https://formspree.io/f/mbdergze" method="POST" data-diagnostic={diagnosticName}>
    <label>Name
      <input name="name" type="text" autocomplete="name" required />
    </label>
    <label>Email
      <input name="email" type="email" autocomplete="email" required />
    </label>
    <label>What kind of help are you looking for?
      <select name="engagement" required>
        <option value="">Choose one</option>
        {packages.tiers.map((tier) => <option value={tier.name}>{tier.name}</option>)}
        <option value="Not sure yet">Not sure yet</option>
      </select>
    </label>
    <label class="diagnostic-field" id="diagnostic-field" hidden>Link to the app or repository (optional)
      <input name="app_url" type="url" inputmode="url" autocomplete="url" placeholder="https://" />
    </label>
    <label>Timeframe (optional)
      <select name="timeframe">
        <option value="">No preference</option>
        {timeframes.map((t) => <option value={t}>{t}</option>)}
      </select>
    </label>
    <label>Company or product (optional)
      <input name="company" type="text" autocomplete="organization" />
    </label>
    <label>What needs to change? (include any deadline or technical context)
      <textarea name="message" rows="6" required placeholder="A few sentences are enough to start."></textarea>
    </label>

    <!-- Honeypot: hidden from people, filled in by bots. Formspree discards submissions where it is set. -->
    <div class="hp" aria-hidden="true">
      <label>Leave this field empty
        <input name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <input type="hidden" name="_subject" value="New project enquiry from ctorres.lat" />

    <button type="submit">Send project details <span aria-hidden="true">→</span></button>
    <p class="form-note">I only use your details to reply to this enquiry.</p>
    <div class="form-status" id="form-status" role="status" aria-live="polite" tabindex="-1"></div>
  </form>

  <script define:vars={{ linkedin: site.links.linkedin }}>
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');
    const button = form.querySelector('button[type="submit"]');
    const engagement = form.elements.engagement;
    const diagnosticField = document.getElementById('diagnostic-field');
    const diagnosticName = form.dataset.diagnostic;

    // Only the diagnostic needs a link to the app or repository.
    const syncDiagnosticField = () => {
      diagnosticField.hidden = engagement.value !== diagnosticName;
    };
    engagement.addEventListener('change', syncDiagnosticField);
    syncDiagnosticField();

    const show = (kind, html) => {
      status.className = `form-status ${kind}`;
      status.innerHTML = html;
      status.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const type = String(data.get('engagement') || 'Enquiry');
      data.set('_subject', `${type}: new enquiry from ${name || 'ctorres.lat'}`);

      button.disabled = true;
      button.dataset.label = button.innerHTML;
      button.textContent = 'Sending…';
      status.className = 'form-status';
      status.textContent = '';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(`Formspree responded ${response.status}`);
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'generate_lead', engagement: type });
        form.reset();
        syncDiagnosticField();
        show('ok', '<strong>Thanks, your message is in.</strong> I’ll review the details and get back to you about a next step.');
      } catch (error) {
        show('error', `Something went wrong and your message was not sent. Please try again, or message me on <a href="${linkedin}" target="_blank" rel="noopener noreferrer">LinkedIn</a>.`);
      } finally {
        button.disabled = false;
        button.innerHTML = button.dataset.label;
      }
    });
  </script>
</BaseLayout>
